{
  "headers": [
    {
      "source": "/videos/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/((?!assets|3d_models|Photos|videos|Logo|favicon).*)", "destination": "/index.html" }
  ]
}
